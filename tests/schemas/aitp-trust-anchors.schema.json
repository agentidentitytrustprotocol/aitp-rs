{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentidentitytrustprotocol.io/schema/v0.3/trust-anchors.json",
  "title": "TrustAnchorsConfig",
  "description": "AITP v0.3 trust anchor and pinned key configuration.",
  "type": "object",
  "properties": {
    "trust_anchors": {
      "type": "array",
      "description": "Trusted OIDC issuers and their public keys.",
      "items": {
        "type": "object",
        "required": [
          "issuer",
          "keys"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43,44}$"
            },
            "minItems": 1,
            "description": "base64url-encoded public keys."
          }
        },
        "additionalProperties": false
      }
    },
    "pinned_keys": {
      "type": "array",
      "description": "Pre-configured agent keys (for pinned_key identity type).",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "public_key"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "ed25519",
              "p256"
            ],
            "description": "OPTIONAL key algorithm. Entries are keyed by (algorithm, public_key) (RFC-AITP-0002 §3.2 step 3). When absent it is inferred from the key length; when present it MUST match it: 43 chars for ed25519, 44 chars (SEC1 compressed point) for p256."
          },
          "public_key": {
            "type": "string",
            "minLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43,44}$",
            "description": "base64url public key in the RFC-AITP-0001 §5.3 AID-identifier form: 43 chars for Ed25519, 44 chars for P-256."
          },
          "allowed_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "algorithm"
              ],
              "properties": {
                "algorithm": {
                  "const": "ed25519"
                }
              }
            },
            "then": {
              "properties": {
                "public_key": {
                  "minLength": 43,
                  "maxLength": 43
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "algorithm"
              ],
              "properties": {
                "algorithm": {
                  "const": "p256"
                }
              }
            },
            "then": {
              "properties": {
                "public_key": {
                  "minLength": 44,
                  "maxLength": 44
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "key_resolution": {
      "type": "object",
      "properties": {
        "offline_mode": {
          "type": "boolean",
          "default": false
        },
        "cache_ttl_secs": {
          "type": "integer",
          "minimum": 0,
          "default": 3600
        },
        "fail_mode": {
          "type": "string",
          "enum": [
            "fail_closed",
            "fail_open",
            "soft_fail"
          ],
          "default": "fail_closed"
        }
      },
      "additionalProperties": false
    },
    "revocation_policy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fail_closed",
            "fail_open",
            "soft_fail"
          ],
          "default": "fail_closed"
        },
        "max_staleness_secs": {
          "type": "integer",
          "minimum": 0,
          "default": 300
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "trust_anchors": [
        {
          "issuer": "https://auth.openai.com",
          "keys": [
            "agentA_pubkey_AID_v01_placeholder_AAAAAAAAA",
            "agentB_pubkey_AID_v01_placeholder_BBBBBBBBB"
          ]
        },
        {
          "issuer": "https://auth.anthropic.com",
          "keys": [
            "agentC_pubkey_AID_v01_placeholder_CCCCCCCCC"
          ]
        }
      ],
      "pinned_keys": [
        {
          "subject": "internal-worker-1",
          "public_key": "worker_pubkey_AID_v01_placeholder_wwwwwwwww",
          "allowed_capabilities": [
            "macp.mode.task.v1"
          ]
        }
      ],
      "key_resolution": {
        "offline_mode": false,
        "cache_ttl_secs": 3600,
        "fail_mode": "fail_closed"
      },
      "revocation_policy": {
        "mode": "fail_closed",
        "max_staleness_secs": 300
      }
    }
  ]
}
