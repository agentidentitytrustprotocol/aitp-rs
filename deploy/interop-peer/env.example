# Environment for `aitp serve --interop` (docs/interop-peer.md).
# The key itself comes from the secret store, never from this file. On
# Railway the keys in deploy/doppler-keys.txt live in Doppler
# (aitp-interop-peer, prd/stg) and reach the service via
# deploy/doppler-sync.sh. The ENROL and RATE settings are not listed, so
# their defaults apply; see docs/interop-peer.md to override one.
AITP_PEER_KEY=            # `aitp keygen` output or a bare hex seed
AITP_PUBLIC_URL=https://interop.agentidentitytrustprotocol.io
AITP_TRUSTED_PROXIES=100.64.0.0/10   # Railway's edge; CIDRs, comma-separated
AITP_CLIENT_IP_HEADER=x-real-ip       # Railway writes the client here
AITP_ENROL_TTL=86400
AITP_ENROL_CAP=10000
AITP_ENROL_PER_IP_PER_HOUR=5
AITP_RATE_PER_IP_PER_MINUTE=120     # every request, per client address; 0 = off
# AITP_RATE_BURST=120                # default: the per-minute value
RUST_LOG=info
