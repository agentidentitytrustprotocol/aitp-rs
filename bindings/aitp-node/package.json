{
  "name": "@agentidentitytrustprotocol/aitp",
  "version": "0.25.0",
  "description": "Agent Identity Trust Protocol — Node.js SDK",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentidentitytrustprotocol/aitp-rs.git",
    "directory": "bindings/aitp-node"
  },
  "homepage": "https://github.com/agentidentitytrustprotocol/aitp-rs/tree/main/bindings/aitp-node",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "aitp",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:experimental": "napi build --platform --features experimental --js experimental.js --dts experimental.d.ts",
    "build:minimal": "napi build --platform --release --no-default-features",
    "build:minimal:debug": "napi build --platform --no-default-features",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "node --test tests/*.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "jose": "^6.2.3",
    "node-forge": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
